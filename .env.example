# ──────────────────────────────────────────────
# F1 StratLab — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env — it is in .gitignore.
# ──────────────────────────────────────────────

# --- LLM provider (required) ---
# "openai" uses the OpenAI API; "lmstudio" uses a local LM Studio server.
F1_LLM_PROVIDER=openai

# --- OpenAI (required when F1_LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-your-key-here

# --- LM Studio (only when F1_LLM_PROVIDER=lmstudio) ---
# LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1

# --- Telemetry backend security (issue #224, Phase A) ---
# These are read by the telemetry backend (src/telemetry); the backend loads
# this file first, then its own src/telemetry/.env as an override.

# Shared API key. When SET, every backend request needs `X-API-Key: <key>`
# except OPTIONS, `/`, and `/health`. When UNSET (or empty) the backend is
# unauthenticated — allowed only on a loopback bind (the startup guard refuses a
# non-loopback bind with no key). Single shared secret; no per-user accounts.
# F1_API_KEY=change-me

# Host the backend binds to. Defaults to 127.0.0.1 (loopback-only). Set 0.0.0.0
# to expose it — which then makes F1_API_KEY mandatory (fail-closed).
# F1_HOST=127.0.0.1

# External /mcp Streamable-HTTP endpoint. OFF by default; the chat uses the same
# tools in-process regardless. Enable only to let external MCP clients connect,
# and then only behind F1_API_KEY.
# F1_MCP_ENABLED=false

# Server-side cap on completion tokens per chat turn. A larger client request is
# clamped down to it. Defaults to 2048.
# F1_CHAT_MAX_TOKENS=2048
