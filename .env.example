# ──────────────────────────────────────────────
# F1 StratLab — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env — it is in .gitignore.
# ──────────────────────────────────────────────

# --- LLM provider (required) ---
# "openai" uses the OpenAI API; "lmstudio" uses a local LM Studio server.
F1_LLM_PROVIDER=openai

# --- OpenAI (required when F1_LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-your-key-here

# --- LM Studio (only when F1_LLM_PROVIDER=lmstudio) ---
# Host running the LM Studio server, read by the telemetry backend
# (src/telemetry/backend/services/chatbot/llm_service.py:26). The port is fixed at
# 1234. Both compose files already set it to host.docker.internal so a container
# reaches the server on the host.
# LM_STUDIO_HOST=localhost

# --- Model per layer (optional) ---
# The sub-agents N26-N30 and the orchestrator N31 resolve their model through
# src/agents/_shared_defaults.py at the moment a client is built. Unset means the
# defaults below. On the lmstudio provider the string is still sent, but the server
# answers with whatever model it has loaded.
# F1_LLM_MODEL_AGENTS=gpt-4.1-mini
# F1_LLM_MODEL_ORCHESTRATOR=gpt-5.4-mini

# Model for the webapp chat tab, which is a separate layer with its own client
# (llm_service.py:34). A chat request may also name a model per turn.
# OPENAI_CHAT_MODEL=gpt-5.4-mini

# Seconds the chat client waits for a completion (llm_service.py:45). Defaults to 60
# on openai and 120 on lmstudio, because a local server is slower to first token.
# F1_LLM_TIMEOUT=60

# --- Telemetry backend security (issue #224, Phase A) ---
# These are read by the telemetry backend (src/telemetry); the backend loads
# this file first, then its own src/telemetry/.env as an override.

# Shared API key. When SET, every backend request needs `X-API-Key: <key>`
# except OPTIONS, `/`, and `/health`. When UNSET (or empty) the backend is
# unauthenticated — allowed only on a loopback bind (the startup guard refuses a
# non-loopback bind with no key). Single shared secret; no per-user accounts.
# F1_API_KEY=change-me

# Host the backend binds to. Defaults to 127.0.0.1 (loopback-only). Set 0.0.0.0
# to expose it — which then makes F1_API_KEY mandatory (fail-closed).
# F1_HOST=127.0.0.1

# External /mcp Streamable-HTTP endpoint. OFF by default; the chat uses the same
# tools in-process regardless. Enable only to let external MCP clients connect,
# and then only behind F1_API_KEY.
# F1_MCP_ENABLED=false

# Server-side cap on completion tokens per chat turn. A larger client request is
# clamped down to it. Defaults to 2048.
# F1_CHAT_MAX_TOKENS=2048
